menu "Router Wi-Fi AP"

    config ROUTER_AP_SSID
        string "Wi-Fi SSID"
        default "ESP32-S31-Router"
        help
            Access point name, from 1 to 32 bytes.

    config ROUTER_AP_PASSWORD
        string "Wi-Fi password"
        default "ChangeMe-S31!"
        help
            WPA2 password, from 8 to 63 bytes. Change the default before use.

    config ROUTER_AP_CHANNEL
        int "Wi-Fi channel (2.4 GHz)"
        range 1 11
        default 6

    config ROUTER_AP_MAX_CLIENTS
        int "Maximum connected devices"
        range 1 10
        default 4

    config ROUTER_FALLBACK_DNS
        string "Fallback IPv4 DNS server"
        default "1.1.1.1"
        help
            Used only when the Ethernet DHCP lease supplies no IPv4 DNS server.

endmenu
